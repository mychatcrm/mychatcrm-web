# =======================================================================
# .env.example — Copie para .env.local e preencha os valores
# NUNCA commite .env.local ou .env.production (cobertos pelo .gitignore)
# =======================================================================

# ---- Build / Console --------------------------------------------------
# Em produção, console.* são removidos (exceto error/warn).
# Para manter logs locais:
# KEEP_CONSOLE=1

# ---- Site público -----------------------------------------------------
# URL canônica. Use SEMPRE https:// em produção.
# Usado em: metadata, Open Graph, next-sitemap, cookie Secure flag.
NEXT_PUBLIC_SITE_URL=https://mychatcrm.com.br

# ---- HTTPS / Segurança ------------------------------------------------
# Redirecionamento HTTP→HTTPS no middleware (desative só em diagnóstico):
# DISABLE_HTTPS_REDIRECT=1
# HSTS: ativo em produção Vercel (VERCEL_ENV=production) ou force:
# ENABLE_HSTS=1
# HSTS_PRELOAD=1   (só após validar em https://hstspreload.org/)
# Upgrade de recursos mixed-content:
# CSP_UPGRADE_INSECURE_REQUESTS=1

# ---- WhatsApp ---------------------------------------------------------
# Número com DDI (só dígitos) — CTAs e handoff do chat de marketing
NEXT_PUBLIC_WHATSAPP_HANDOFF=

# ---- Chat de marketing (/api/chat) ------------------------------------
# Chaves SOMENTE no servidor — jamais use NEXT_PUBLIC_ aqui.
# Provedor: openai (padrão) | anthropic
CHAT_AI_PROVIDER=openai

OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-3-haiku-20240307

# ---- Sessão de cliente (OBRIGATÓRIO em produção) ----------------------
# Segredo HMAC para assinar cookies de sessão dos clientes.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRÍTICO: sem este valor em produção, o login de colaboradores retorna 503.
CLIENT_SESSION_COOKIE_SECRET=

# ---- Auth Demo vs Produção -------------------------------------------
# Em VERCEL_ENV=production: contas demo e tokens estáticos ficam DESATIVADOS.
# Login /admin em produção (renatolagares@live.com, suporte@, financeiro@):
# defina na Vercel (Production): ALLOW_DEMO_PASSWORD_AUTH=1 e DEMO_ADMIN_PASSWORD
# (valor forte; não commite aqui). CLIENT_SESSION_COOKIE_SECRET também é obrigatório.
# Para forçar demo em produção (não recomendado):
# ALLOW_DEMO_PASSWORD_AUTH=1
# Para desativar demo em preview:
# ALLOW_DEMO_PASSWORD_AUTH=0
# Senhas demo (só quando demo ativo):
DEMO_CLIENT_PASSWORD=
DEMO_ADMIN_PASSWORD=
# UI de ajuda no login:
# NEXT_PUBLIC_SHOW_DEMO_LOGIN_HELP=1
# NEXT_PUBLIC_DEMO_CLIENT_EMAIL=
# NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
# NEXT_PUBLIC_DEMO_REAUTH_PASSWORD=

# ---- Admin ------------------------------------------------------------
# Lista de IPs permitidos no painel admin (vazia = sem whitelist):
ADMIN_IP_WHITELIST=

# ---- Cookies ----------------------------------------------------------
# Força flag Secure mesmo sem HTTPS (ex: proxy local):
# COOKIE_FORCE_SECURE=1
# Desativa Secure em produção (debug apenas):
# COOKIE_INSECURE=1

# ---- Supabase ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # ← NUNCA NEXT_PUBLIC_; somente no servidor

# ---- E-mail transacional (Resend) — recuperação de palavra-passe -----
# Crie conta em https://resend.com → API Keys
RESEND_API_KEY=
# Remetente verificado no Resend (ex: MyChatCRM <onboarding@resend.dev>)
RESEND_FROM_EMAIL=

# ---- Stripe -----------------------------------------------------------
# Chave secreta Stripe (Developers → API Keys → Secret key)
# NUNCA use NEXT_PUBLIC_ para a chave secreta.
STRIPE_SECRET_KEY=

# Segredo do webhook Stripe (Developers → Webhooks → seu endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=

# Price IDs de cada plano e ciclo (Stripe Dashboard → Products → cada produto → cada preço)
# Formato: price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_EQUIPA_MONTHLY=
STRIPE_PRICE_EQUIPA_ANNUAL=
STRIPE_PRICE_ESCALA_MONTHLY=
STRIPE_PRICE_ESCALA_ANNUAL=

# ---- Modo manutenção --------------------------------------------------
# Estado persistido em data/maintenance/state.json
# Gerenciado pelo painel admin em /admin (requer sessão admin)
# Health check público: GET /api/health
# Status de manutenção: GET /api/maintenance/status

# ---- ATENÇÃO: checklist de pré-deploy --------------------------------
# [ ] CLIENT_SESSION_COOKIE_SECRET preenchido com valor forte (32+ bytes)
# [ ] Se o repositório for público: initialPassword em data/team-employees/*.json é visível a todos — rode um deploy e troque a senha no painel assim que possível.
# [ ] OPENAI_API_KEY ou ANTHROPIC_API_KEY configurado
# [ ] NEXT_PUBLIC_SITE_URL aponta para o domínio de produção com https://
# [ ] NEXT_PUBLIC_WHATSAPP_HANDOFF configurado
# [ ] ALLOW_DEMO_PASSWORD_AUTH=0 (ou não definido) em produção
# [ ] STRIPE_SECRET_KEY configurado
# [ ] STRIPE_PRICE_* configurados (6 IDs de preço no total)
# [ ] STRIPE_WEBHOOK_SECRET configurado (após criar o endpoint no Stripe Dashboard)
# [ ] Webhook Stripe apontando para https://seudominio.com/api/webhooks/stripe
# [ ] Sistema de pagamento testado com cartão de teste Stripe (4242 4242 4242 4242)
# [ ] Termos de Uso e Política de Privacidade substituídos por documentos reais
# [ ] /public/og-image.png criado (1200×630px) para Open Graph
