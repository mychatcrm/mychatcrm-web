# Build produção: remove console.* (exceto error/warn). Para manter logs: KEEP_CONSOLE=1
# KEEP_CONSOLE=

# --- Site público ---
# Em produção use sempre https:// (callbacks, links absolutos, flag Secure nos cookies).
NEXT_PUBLIC_SITE_URL=https://mychatcrm.com.br

# --- HTTPS / segurança (produção) ---
# Redirecionamento HTTP→HTTPS no middleware (desative só em diagnóstico): DISABLE_HTTPS_REDIRECT=1
# HSTS no next.config: ativo em produção na Vercel (VERCEL_ENV=production) ou force com ENABLE_HSTS=1
# Submissão preload HSTS (só após validar em https://hstspreload.org/): HSTS_PRELOAD=1
# Mixed content: força upgrade de http em recursos (opcional): CSP_UPGRADE_INSECURE_REQUESTS=1

# Número WhatsApp (apenas dígitos) para CTAs e handoff do chat de marketing
NEXT_PUBLIC_WHATSAPP_HANDOFF=

# --- Chat de marketing (/api/chat) — chaves APENAS no servidor (nunca NEXT_PUBLIC_*) ---
# Valores: openai (padrão) | anthropic
CHAT_AI_PROVIDER=openai

OPENAI_API_KEY=
# Opcional — modelo para o widget do site
# OPENAI_CHAT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-3-haiku-20240307

# --- Sessão cliente (assinatura de cookie em produção) ---
# Obrigatório em VERCEL_ENV=production (cookies mc1.; sem isto o login de colaboradores falha com 503).
CLIENT_SESSION_COOKIE_SECRET=

# --- Autenticação demo vs produção ---
# Em VERCEL_ENV=production: logins com contas demo/senhas estáticas e tokens «*-demo» ficam DESATIVADOS.
# Para forçar demo na produção (não recomendado): ALLOW_DEMO_PASSWORD_AUTH=1
# Para desativar demo em preview: ALLOW_DEMO_PASSWORD_AUTH=0
# Senhas demo no servidor (só quando demo ativo): DEMO_CLIENT_PASSWORD=  |  DEMO_ADMIN_PASSWORD=
# UI de login: NEXT_PUBLIC_SHOW_DEMO_LOGIN_HELP=1 mostra textos de ajuda (sem expor senha no código).
# NEXT_PUBLIC_DEMO_CLIENT_EMAIL=  NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
# Reautenticação simulada no painel: NEXT_PUBLIC_DEMO_REAUTH_PASSWORD= (ou omitir com SHOW_DEMO_LOGIN_HELP=1 → «admin»)

# --- Modo manutenção global ---
# Estado persistido em data/maintenance/state.json (criado ao primeiro PATCH em /admin/segurança).
# GET público: /api/maintenance/status · Health: GET /api/health

# --- Admin ---
ADMIN_IP_WHITELIST=

# --- Cookies (produção) ---
# COOKIE_FORCE_SECURE=1
