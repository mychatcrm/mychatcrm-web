{
  "name": "mychatcrm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:free-port": "for p in 3000 3022 3030; do lsof -ti:$p | xargs kill -9 2>/dev/null || true; done",
    "dev": "npm run dev:free-port && node scripts/dev.mjs",
    "dev:turbo": "npm run dev:free-port && node scripts/dev.mjs --turbo",
    "dev:lan": "npm run dev:free-port && NEXT_DEV_HOSTNAME=0.0.0.0 node scripts/dev.mjs",
    "clean": "rm -rf .next node_modules/.cache",
    "dev:clean": "npm run clean && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "postbuild": "node scripts/fix-next-server-chunks.mjs && next-sitemap",
    "clean:analyze": "tsx scripts/cleanup-engine/cleanup.ts analyze",
    "clean:execute": "tsx scripts/cleanup-engine/cleanup.ts execute",
    "clean:scan": "tsx scripts/cleanup-engine/executeCleanup.ts scan",
    "clean:report": "tsx scripts/cleanup-engine/executeCleanup.ts report",
    "clean:safe": "tsx scripts/cleanup-engine/executeCleanup.ts safe",
    "clean:deep": "tsx scripts/cleanup-engine/executeCleanup.ts deep",
    "resend:push-vercel": "node scripts/push-resend-to-vercel.mjs",
    "verify:ia-env": "node scripts/verify-ia-hub-env.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "next": "14.2.35",
    "next-intl": "^4.9.2",
    "next-sitemap": "^4.2.3",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "stripe": "^22.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  }
}
