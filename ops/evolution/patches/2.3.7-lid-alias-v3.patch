+export function resolveCanonicalChatRemoteJid(key: Pick<ExtendedIMessageKey, 'remoteJid' | 'remoteJidAlt'>): string {
+  const remoteJid = key.remoteJid?.trim() || '';
+  const remoteJidAlt = key.remoteJidAlt?.trim() || '';
+  if (remoteJid.endsWith('@lid') && remoteJidAlt && !remoteJid.endsWith('@g.us')) {
+    return remoteJidAlt;
+  }
+  return remoteJid;
